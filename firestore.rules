rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dynamic website content configuration
    match /site_content/{document=**} {
      allow read, write: if true;
    }
    
    // Chunked video storage
    match /site_hero_video/{chunk=**} {
      allow read, write: if true;
    }

    // Portfolio projects
    match /site_projects/{project=**} {
      allow read, write: if true;
    }

    // Before and After transformations
    match /site_transformations/{item=**} {
      allow read, write: if true;
    }
  }
}
